# OpenAI API key (required). Use a key from an OpenAI-compatible proxy if you set OPENAI_BASE_URL.
OPENAI_API_KEY=sk-...

# OpenAI-compatible base URL. Override for OpenRouter, vLLM, DeepSeek, etc.
OPENAI_BASE_URL=https://api.openai.com/v1

# Vision model that supports image input (e.g. gpt-4o, gpt-4o-mini, o1).
OPENAI_MODEL=gpt-4o

# Rendering quality of each PDF page. Higher = sharper but larger.
PDF_DPI=200

# Maximum number of pages sent to the model per request.
MAX_PAGES=10

# Largest side length of a rendered page image, in pixels.
IMAGE_MAX_SIDE=2000

# JPEG quality for rendered page images (1-100).
IMAGE_QUALITY=75
